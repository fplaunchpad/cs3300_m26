source "https://rubygems.org"

# Built with Jekyll 4 and deployed by .github/workflows/pages.yml.
# (The old `github-pages` gem pinned Jekyll 3.9.2 and no longer installs on
# current Ruby; the site uses no GitHub Pages plugins, so nothing depends on it.)
gem "jekyll", "~> 4.4"
gem "kramdown-parser-gfm", "~> 1.1"   # kramdown 2 split GFM out into its own gem
gem "webrick", "~> 1.9"               # no longer bundled with Ruby, needed by `jekyll serve`
